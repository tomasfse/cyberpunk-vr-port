<!--
  Vortex/MO2 installer definition. It installs; it does NOT check dependencies.

  It used to carry a moduleDependencies gate on the six required mods. That gate can never
  work for this game: Vortex answers a FOMOD fileDependency out of getAllPlugins(), its
  plugin/load-order list, and Cyberpunk has no plugins and no load order in Vortex. The list
  comes back empty, every check resolves to "not Active" no matter what is on disk, and the
  install is refused for everybody. Observed on 0.1.2-dev.3f1766d: all six reported missing
  on a machine that had all six.

  Dependency checking belongs in the Requirements list on the Nexus page, which is a separate
  web form, is what Vortex actually reads, and can offer to install what is missing. A FOMOD
  can only refuse; it was never able to fetch anything anyway.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">

  <moduleName>CyberpunkVRPort</moduleName>

  <!--
    Everything, unconditionally. The package is already laid out as it must land in the game root,
    so source and destination are the same tree and there is nothing to choose. INSTALL.txt is
    deliberately not installed: it is a note for whoever opens the archive, not a file that
    belongs in a player's game folder.
  -->
  <requiredInstallFiles>
    <folder source="red4ext"  destination="red4ext"  priority="0"/>
    <folder source="bin"      destination="bin"      priority="0"/>
    <folder source="r6"       destination="r6"       priority="0"/>
    <folder source="archive"  destination="archive"  priority="0"/>
    <folder source="engine"   destination="engine"   priority="0"/>
  </requiredInstallFiles>

</config>
