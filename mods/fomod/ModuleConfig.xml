<!--
  Vortex/MO2 installer. It installs; it does NOT check dependencies.

  A moduleDependencies gate was tried and removed: Vortex answers a FOMOD fileDependency out of
  its plugin/load-order list, which Cyberpunk does not have, so every check failed and the
  install was refused for everybody. Dependency checking belongs in the Nexus Requirements list.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">

  <moduleName>CyberpunkVRPort</moduleName>

  <!--
    Everything, unconditionally. The package is already laid out as it must land in the game root,
    so source and destination are the same tree and there is nothing to choose. INSTALL.txt is
    deliberately not installed: it is a note for whoever opens the archive, not a file that
    belongs in a player's game folder.
  -->
  <requiredInstallFiles>
    <folder source="red4ext"  destination="red4ext"  priority="0"/>
    <folder source="bin"      destination="bin"      priority="0"/>
    <folder source="r6"       destination="r6"       priority="0"/>
    <folder source="archive"  destination="archive"  priority="0"/>
    <folder source="engine"   destination="engine"   priority="0"/>
  </requiredInstallFiles>

</config>
